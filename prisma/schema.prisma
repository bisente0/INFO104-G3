datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  name      String
  password  String // ENCRIPTAR...
  posts     Post[]
  createdAt DateTime @default(now())
}

model Book {
  isbn13    String  @id
  name      String
  author    String
  year      String?
  category  String?
  language  String?
  publisher String?
  coverPath String
  posts     Post[]
}

model Post {
  id        Int     @id @default(autoincrement())
  msg       String
  date      DateTime  @default(now())
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  bookIsbn  String
  book      Book    @relation(fields: [bookIsbn], references: [isbn13])
}